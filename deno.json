{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys --env src/index.ts",
    "db:generate": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys --env npm:prisma@7.9.1 generate",
    "db:migrate": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys --env npm:prisma@7.9.1 migrate dev",
    "db:push": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys --env npm:prisma@7.9.1 db push",
    "db:seed": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys --env src/seed.ts",
    "db:studio": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys --env npm:prisma@7.9.1 studio",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-sys"
  },
  "imports": {
    "@types/qrcode": "npm:@types/qrcode@^1.5.6",
    "hono": "npm:hono@^4.6.0",
    "@hono/node-server": "npm:@hono/node-server@^1.13.8",
    "hono/cors": "npm:hono@^4.6.0/cors",
    "hono/logger": "npm:hono@^4.6.0/logger",
    "better-auth": "npm:better-auth@^1.1.0",
    "better-auth/plugins": "npm:better-auth@^1.1.0/plugins",
    "@prisma/client": "npm:@prisma/client@7.9.1",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@7.9.1",
    "pdf-lib": "npm:pdf-lib@^1.17.1",
    "pg": "npm:pg@^8.13.0",
    "@types/pg": "npm:@types/pg@^8.11.10",
    "qrcode": "npm:qrcode@^1.5.4",
    "zod": "npm:zod@^3.23.8",
    "dotenv": "npm:dotenv@^16.4.5"
  },
  "nodeModulesDir": "auto",
  "lock": false,
  "unstable": ["sloppy-imports"],
  "compilerOptions": {
    "lib": ["deno.window", "deno.ns"],
    "strict": true
  }
}
