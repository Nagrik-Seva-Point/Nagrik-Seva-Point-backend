datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---
enum AccessMode {
  GUEST
  RETAILER
}

enum PricingTier {
  PUBLIC
  PARTNER
  PARTNER_GOLD
  ENTERPRISE
}

enum RequestStatus {
  // Legacy / Compatibility
  CREATED
  SUCCESS
  FAILED

  // Production State Machine
  REQUEST_CREATED
  PRICE_LOCKED
  PAYMENT_PENDING
  PAYMENT_CAPTURED
  PROCESSING
  COMPLETED
  PROVIDER_FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASHFREE
  WALLET
  FREE_PILOT
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

// --- BETTER-AUTH CORE & ORGANIZATION ---
model User {
  id            String    @id
  name          String
  email         String    @unique
  phone         String?   @unique // 10-digit mobile number for Phone
  role          UserRole  @default(USER)
  emailVerified Boolean   @default(true)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  requests      ServiceRequest[]
  payments      Payment[]
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// Organization = Cyber Café
model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String?  @unique
  logo        String?
  createdAt   DateTime @default(now())
  metadata    String?

  members     Member[]
  invitations Invitation[]

  // Business relationships
  customers   Customer[]
  requests    ServiceRequest[]
  wallet      Wallet?
  payments    Payment[]
}

model Member {
  id             String       @id @default(uuid())
  role           String       // owner, staff
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String
  status         String       // pending, accepted, rejected
  expiresAt      DateTime
  inviterId      String
}

// --- BUSINESS MODELS ---

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  phone          String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  requests       ServiceRequest[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, name])
  @@index([organizationId, phone])
}

// --- SERVICE CATEGORIES ---
model ServiceCategory {
  id           String    @id @default(uuid())
  code         String    @unique // e.g. "IDENTITY_TAX", "ELECTION", "TRANSPORT"
  name         String    // e.g. "Identity & Tax", "Electoral Services"
  description  String?
  icon         String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  services     Service[]
}

// --- SERVICE CATALOGUE & CAPABILITIES ---
model Service {
  id               String           @id @default(uuid())
  code             String           @unique // e.g., "PAN_FIND", "VOTER_VERIFY"
  name             String
  description      String?
  categoryId       String?
  category         ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isActive         Boolean          @default(true)
  retailerPrice    Decimal?         @db.Decimal(10, 2) // Legacy compatibility

  // Service Capability Flags
  isPublicAllowed   Boolean         @default(true)  // Whether GUEST mode can access
  isRetailerAllowed Boolean         @default(true)  // Whether RETAILER mode can access
  requiresCustomer  Boolean         @default(false) // Mandatory customer record for retailers
  requiresUpload    Boolean         @default(false) // Photo / signature upload required
  producesDocument  Boolean         @default(false) // Generates downloadable PDF

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  prices           ServicePrice[]
  requests         ServiceRequest[]
}

model ServicePrice {
  id            String       @id @default(uuid())
  serviceId     String
  service       Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  pricingTier   PricingTier
  amount        Decimal      @db.Decimal(10, 2)
  currency      String       @default("INR")
  effectiveFrom DateTime     @default(now())
  effectiveTo   DateTime?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([serviceId, pricingTier])
}

// --- CENTRAL SERVICE REQUEST ENTITY ---
model ServiceRequest {
  id                String               @id @default(uuid())
  referenceNumber   String?              @unique // e.g., "REQ-20260821-ABC123"
  serviceId         String
  service           Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  accessMode        AccessMode           @default(RETAILER)
  pricingTier       PricingTier          @default(PARTNER)

  // Contextual Relations (Nullable for Guests)
  userId            String?
  user              User?                @relation(fields: [userId], references: [id])
  organizationId    String?
  organization      Organization?        @relation(fields: [organizationId], references: [id])
  customerId        String?
  customer          Customer?            @relation(fields: [customerId], references: [id])
  guestSessionId    String?              // Anonymous tracking ID for guest requests

  // Immutable Price Snapshot
  amount            Decimal              @default(0.00) @db.Decimal(10, 2)
  currency          String               @default("INR")

  status            RequestStatus        @default(REQUEST_CREATED)

  // Payloads & Results
  inputData         Json                 // Operational request payload (non-sensitive/redacted)
  resultData        Json?                // Normalized response returned to client
  providerId        String?              // Identifier of provider used (e.g., "EZYTM", "MOCK")
  providerReference String?              // Provider's internal reference ID
  idempotencyKey    String?              @unique

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  completedAt       DateTime?

  events            ServiceRequestEvent[]
  payments          Payment[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([guestSessionId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([serviceId, status])
  @@index([customerId])
}

model ServiceRequestEvent {
  id               String          @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  status           RequestStatus
  note             String?
  createdAt        DateTime        @default(now())

  @@index([serviceRequestId, createdAt])
}

// --- PAYMENTS ---
model Payment {
  id               String          @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  organizationId   String?
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  userId           String?
  user             User?           @relation(fields: [userId], references: [id])
  guestSessionId   String?

  amount           Decimal         @db.Decimal(10, 2)
  currency         String          @default("INR")
  method           PaymentMethod   @default(CASHFREE)
  status           PaymentStatus   @default(PENDING)

  // Standard Gateway & Transaction Fields
  orderId          String?         // Cashfree Order ID (e.g. "CF_ORD_...")
  transactionId    String?         // Gateway Transaction Reference (cf_payment_id)
  paymentSessionId String?         // Cashfree Payment Session ID
  paymentMode      String?         // UPI, CARD, NETBANKING, WALLET, etc.
  bankReference    String?         // UTR / Bank Reference Number
  errorMessage     String?         // Gateway failure reason or error code
  gatewayResponse  Json?           // Full raw webhook/gateway response snapshot for audit & debugging

  paidAt           DateTime?
  refundedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([orderId])
  @@index([transactionId])
  @@index([serviceRequestId])
  @@index([organizationId, status, createdAt])
  @@index([userId, status])
  @@index([guestSessionId])
}

// --- WALLET & LEDGER (Prepared for future activation) ---
model Wallet {
  id             String              @id @default(uuid())
  organizationId String              @unique
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  balance        Decimal             @default(0.00) @db.Decimal(10, 2)
  currency       String              @default("INR")
  updatedAt      DateTime            @updatedAt

  transactions   WalletTransaction[]
}

model WalletTransaction {
  id           String          @id @default(uuid())
  walletId     String
  wallet       Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount       Decimal         @db.Decimal(10, 2)
  type         TransactionType
  balanceAfter Decimal         @db.Decimal(10, 2)
  referenceId  String?         // Points to ServiceRequest.id or Payment.id
  description  String?
  createdAt    DateTime        @default(now())

  @@index([walletId, createdAt(sort: Desc)])
  @@index([referenceId])
}
